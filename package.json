{
  "name": "agent-anjaneya",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@agent-anjaneya/protocol && npm run build --workspace=backend && npm run build --workspace=desktop",
    "test": "npm run test --workspace=backend",
    "backend": "npm run dev --workspace=backend",
    "desktop": "npm run dev --workspace=desktop",
    "mobile": "npm run web --workspace=mobile"
  }
}
